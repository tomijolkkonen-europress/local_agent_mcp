# Kopioi tämä tiedostoksi .env ja täytä arvot. Älä commitoi .env-tiedostoa.

# --- Fabric data agent (MCP-serveri) ---
# Oletuksena URL luetaan tiedostosta mcp.json (lataa Fabricin data agentin
# Settings -> Model Context Protocol -välilehdeltä, ks. mcp.example.json).
# MCP_CONFIG_FILE=mcp.json
# Jos mcp.json sisältää useita palvelimia, valitse niistä yksi nimellä:
# FABRIC_MCP_SERVER=
# Vaihtoehtoisesti koko URL suoraan...
FABRIC_MCP_URL=
# ...tai workspace- ja data agent -ID:t, joista URL kootaan.
FABRIC_WORKSPACE_ID=
FABRIC_DATA_AGENT_ID=
# Valinnainen: tenant, jos tunnuksellasi on pääsy useaan tenanttiin.
AZURE_TENANT_ID=

# --- Claude ---
# API-avain: poista kommentti ja täytä, tai aseta ympäristömuuttujaksi.
# (Tyhjä arvo ohittaisi muut tunnistautumistavat, siksi kommentoitu.)
# ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=16000

# --- MCP ---
MCP_READ_TIMEOUT_S=600
